---
import DirectLocalizedText from '../language/DirectLocalizedText.astro';

export interface Props {
  name?: string;
  descriptionEs?: string;
  descriptionEn?: string;
  className?: string;
}

const {
  name = '',
  descriptionEs = '',
  descriptionEn = '',
  className = '',
} = Astro.props;
---

<div
  class={`flex flex-col gap-5 text-center sm:gap-5 md:gap-5 md:text-left xl:gap-0 ${className}`}
>
  <h1
    class="text-4xl font-bold text-gray-950 md:mb-5 md:pl-5 md:text-6xl xl:mx-4 xl:mb-5 dark:text-gray-100"
  >
    {name}
  </h1>
  <p
    class="max-w-3xl px-8 py-4 text-lg leading-10 text-gray-950 sm:px-8 md:mr-25 xl:mr-8 xl:mb-10 dark:text-gray-100"
  >
    <DirectLocalizedText
      es={descriptionEs}
      en={descriptionEn || descriptionEs}
    />
  </p>
</div>
