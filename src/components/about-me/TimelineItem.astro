---
// Entrada de la línea de tiempo de Educación (se dibuja en el servidor).
import DirectLocalizedText from '../language/DirectLocalizedText.astro';
import { timelineIcons } from './timelineIcons';

interface Props {
  title: string; // institución
  date: { es: string; en: string };
  description: { es: string; en: string };
  iconKey?: string; // university | work | certificate
  certificateUrl?: string;
}

const { title, date, description, iconKey = 'default', certificateUrl } = Astro.props as Props;
const icon = timelineIcons[iconKey] ?? timelineIcons.default;
---

<li class="ms-8 mb-10">
  <span
    class="absolute -start-3 flex size-6 items-center justify-center rounded-full bg-blue-300 ring-8 ring-blue-100 dark:bg-blue-800 dark:ring-blue-950/60"
    set:html={icon}
  />
  <h3
    class="mb-1 flex items-center text-lg font-semibold text-gray-950 dark:text-white"
  >
    {title}
  </h3>
  <time
    class="mb-2 block text-sm leading-none font-semibold text-cyan-700 dark:text-cyan-400"
  >
    <DirectLocalizedText es={date.es} en={date.en || date.es} />
  </time>
  <p class="mb-4 text-sm font-normal text-black sm:text-base dark:text-white">
    <DirectLocalizedText
      es={description.es}
      en={description.en || description.es}
    />
  </p>
  {
    certificateUrl && (
      <a
        href={certificateUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 text-sm font-semibold text-cyan-700 underline-offset-4 hover:underline dark:text-cyan-400"
      >
        <DirectLocalizedText es="Ver certificado" en="View certificate" />
      </a>
    )
  }
</li>
