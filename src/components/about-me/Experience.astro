---
import TimelineItem from './TimelineItem.astro';
import Education from '../icons/Education.astro';
import { getAboutMe } from '../../data/translations';
import type { EducationRow } from '../../db/schema';
import '../../styles/about.css';

interface Props {
  items: EducationRow[];
}

const { items } = Astro.props as Props;
const t = getAboutMe('ES');
---

<div data-realtime-sync="about-education">
  {
    items.length > 0 && (
      <div class="about-card-root mt-5 mb-5 flex-1 rounded-xl border-1 border-cyan-400/30 bg-gray-100/30 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/30 hover:shadow-lg dark:border-cyan-500/30 dark:bg-gray-900/30 dark:hover:border-cyan-400">
        <h3 class="mb-6 flex items-center gap-2 text-lg font-semibold text-gray-950 sm:text-xl dark:text-white">
          <span data-i18n-key="aboutMe.experience.heading">
            {t.experience.heading}
          </span>
          <Education class="h-6 w-6" />
        </h3>
        <ol class="relative border-s-2 border-gray-300 dark:border-neutral-700">
          {items.map((item) => (
            <TimelineItem
              title={item.institution}
              date={{ es: item.datesEs, en: item.datesEn }}
              description={{ es: item.descriptionEs, en: item.descriptionEn }}
              iconKey={item.iconKey}
              certificateUrl={
                item.certificateMime
                  ? `/api/education/${item.id}/certificate`
                  : undefined
              }
            />
          ))}
        </ol>
      </div>
    )
  }
</div>
