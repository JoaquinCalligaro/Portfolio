---
// Tarjeta editable en el lugar: los campos van en el slot por defecto, lo que
// cuelga de la tarjeta (ej. tecnologías de una categoría) en el slot "after".
// La lógica está en scripts/admin/listEditor.ts.
import { cardCls, dangerBtnCls, primaryBtnCls, smallBtnCls } from './ui';

interface Props {
  id?: string;
  hidden?: boolean;
  showHide?: boolean;
  compact?: boolean;
}

const {
  id = '',
  hidden = false,
  showHide = true,
  compact = false,
} = Astro.props as Props;
---

<article data-card data-id={id} data-hidden={String(hidden)} class={cardCls}>
  <div class:list={['space-y-3', compact && 'space-y-2']}>
    <slot />
  </div>
  <slot name="after" />
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" data-action="save" disabled class={primaryBtnCls}>
      Guardar
    </button>
    <span data-status class="text-sm text-gray-400" role="status"></span>
    <span class="ml-auto flex flex-wrap gap-2">
      <button
        type="button"
        data-action="up"
        class={smallBtnCls}
        aria-label="Subir">↑</button
      >
      <button
        type="button"
        data-action="down"
        class={smallBtnCls}
        aria-label="Bajar">↓</button
      >
      {
        showHide && (
          <button type="button" data-action="hide" class={smallBtnCls}>
            {hidden ? 'Mostrar' : 'Ocultar'}
          </button>
        )
      }
      <button type="button" data-action="delete" class={dangerBtnCls}
        >Borrar</button
      >
    </span>
  </div>
</article>
