---
// Contenedor de un "editor de lista" (ver scripts/admin/listEditor.ts).
// Slot por defecto: tarjetas existentes. Slot "template": tarjeta vacía para "Agregar".
import { addBtnCls } from './ui';

interface Props {
  endpoint?: string;
  itemLabel: string;
  addLabel: string;
  emptyText?: string;
  isEmpty?: boolean;
  parentField?: string;
  confirmText?: string;
  class?: string;
}

const {
  endpoint = '',
  itemLabel,
  addLabel,
  emptyText = '',
  isEmpty = false,
  parentField,
  confirmText,
  class: className = '',
} = Astro.props as Props;
---

<div
  data-list-editor
  data-endpoint={endpoint}
  data-item-label={itemLabel}
  data-parent-field={parentField}
  data-confirm={confirmText}
  class:list={['space-y-4', className]}
>
  <p data-empty class:list={['text-sm text-gray-400', !isEmpty && 'hidden']}>
    {emptyText}
  </p>
  <div data-list class="space-y-4">
    <slot />
  </div>
  <template data-card-template>
    <slot name="template" />
  </template>
  <button type="button" data-action="add" class={addBtnCls}>{addLabel}</button>
</div>
