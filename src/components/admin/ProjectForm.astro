---
// Formulario para crear/editar un proyecto. Se usa tanto en /admin/new como en /admin/edit/[id]
import type { ProjectRow } from '../../db/schema';

interface Props {
  mode: 'create' | 'edit';
  project?: ProjectRow | null;
}

const { mode, project = null } = Astro.props as Props;

const TECH_OPTIONS = [
  'html',
  'css',
  'tailwind',
  'javascript',
  'typescript',
  'react',
];
---

<form
  id="project-form"
  class="space-y-5 rounded-xl border border-cyan-400/30 bg-gray-900/40 p-6 backdrop-blur-md"
  data-mode={mode}
  data-project-id={project?.id ?? ''}
>
  <p class="text-xs text-gray-500">
    Escribí solo en español: el inglés se traduce automáticamente al guardar.
  </p>

  <div>
    <label class="block text-sm font-medium text-gray-300">Título</label>
    <input
      name="titleEs"
      required
      value={project?.titleEs ?? ''}
      class="mt-1 block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:ring-2 focus:ring-cyan-500 focus:outline-none"
    />
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-300">Descripción</label>
    <textarea
      name="descriptionEs"
      required
      rows="4"
      class="mt-1 block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:ring-2 focus:ring-cyan-500 focus:outline-none"
      >{project?.descriptionEs ?? ''}</textarea
    >
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-gray-300"
        >Link al repositorio (GitHub)</label
      >
      <input
        name="repo"
        type="url"
        value={project?.repo ?? ''}
        class="mt-1 block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:ring-2 focus:ring-cyan-500 focus:outline-none"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-300"
        >Link de la demo en vivo</label
      >
      <input
        name="live"
        type="url"
        value={project?.live ?? ''}
        class="mt-1 block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:ring-2 focus:ring-cyan-500 focus:outline-none"
      />
    </div>
  </div>

  <div>
    <span class="block text-sm font-medium text-gray-300">Tecnologías</span>
    <div class="mt-2 flex flex-wrap gap-3">
      {
        TECH_OPTIONS.map((tech) => (
          <label class="flex items-center gap-1.5 text-sm text-gray-300">
            <input
              type="checkbox"
              name="technologies"
              value={tech}
              checked={project?.technologies?.includes(tech)}
              class="rounded border-gray-700 bg-gray-800 text-cyan-500 focus:ring-cyan-500"
            />
            {tech}
          </label>
        ))
      }
    </div>
  </div>

  <div>
    <span class="block text-sm font-medium text-gray-300">Imágenes</span>
    <input
      id="image-input"
      type="file"
      accept="image/*"
      multiple
      class="mt-1 block w-full text-sm text-gray-300"
    />
    <p id="upload-status" class="mt-1 text-xs text-gray-500"></p>
    <div
      id="images-preview"
      class="mt-3 flex flex-wrap gap-3"
      data-initial-images={JSON.stringify(project?.images ?? [])}
    >
    </div>
  </div>

  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 text-sm text-gray-300">
      <input
        type="checkbox"
        name="featured"
        checked={project?.featured ?? false}
        class="rounded border-gray-700 bg-gray-800 text-cyan-500 focus:ring-cyan-500"
      />
      Destacado
    </label>
    <label class="flex items-center gap-2 text-sm text-gray-300">
      <input
        type="checkbox"
        name="hidden"
        checked={project?.hidden ?? false}
        class="rounded border-gray-700 bg-gray-800 text-cyan-500 focus:ring-cyan-500"
      />
      Oculto
    </label>
  </div>

  <p id="form-error" class="hidden text-sm text-red-400"></p>

  <div class="flex items-center gap-3 pt-2">
    <button
      type="submit"
      class="rounded-md bg-cyan-500 px-4 py-2 font-medium text-gray-950 transition-colors hover:bg-cyan-400"
    >
      {mode === 'create' ? 'Crear proyecto' : 'Guardar cambios'}
    </button>
    <a href="/admin" class="text-sm text-gray-400 hover:text-gray-200">
      Cancelar
    </a>
  </div>
</form>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement;
  const imageInput = document.getElementById(
    'image-input'
  ) as HTMLInputElement;
  const preview = document.getElementById('images-preview') as HTMLElement;
  const uploadStatus = document.getElementById(
    'upload-status'
  ) as HTMLElement;
  const errorEl = document.getElementById('form-error') as HTMLElement;

  let uploadedImages: string[] = JSON.parse(
    preview.dataset.initialImages || '[]'
  );

  function renderPreview() {
    preview.innerHTML = '';
    uploadedImages.forEach((url, index) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'group relative h-20 w-28 overflow-hidden rounded-md';

      const img = document.createElement('img');
      img.src = url;
      img.className = 'h-full w-full object-cover';
      wrapper.appendChild(img);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.textContent = '✕';
      removeBtn.className =
        'absolute top-1 right-1 flex h-5 w-5 items-center justify-center rounded-full bg-black/70 text-xs text-white';
      removeBtn.addEventListener('click', () => {
        uploadedImages.splice(index, 1);
        renderPreview();
      });
      wrapper.appendChild(removeBtn);

      preview.appendChild(wrapper);
    });
  }

  renderPreview();

  imageInput?.addEventListener('change', async () => {
    const files = Array.from(imageInput.files ?? []);
    if (files.length === 0) return;

    uploadStatus.textContent = `Subiendo ${files.length} imagen(es)...`;

    for (const file of files) {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: fd,
      });
      const data = await res.json();
      if (data.ok) {
        uploadedImages.push(data.url);
      } else {
        uploadStatus.textContent = `Error subiendo imagen: ${data.error}`;
        return;
      }
    }

    uploadStatus.textContent = 'Listo';
    imageInput.value = '';
    renderPreview();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');

    const formData = new FormData(form);
    const technologies = formData.getAll('technologies');

    const payload = {
      titleEs: formData.get('titleEs'),
      descriptionEs: formData.get('descriptionEs'),
      repo: formData.get('repo') || '',
      live: formData.get('live') || '',
      technologies,
      images: uploadedImages,
      featured: formData.get('featured') === 'on',
      hidden: formData.get('hidden') === 'on',
    };

    const mode = form.dataset.mode;
    const projectId = form.dataset.projectId;
    const url = mode === 'create'
      ? '/api/admin/projects'
      : `/api/admin/projects/${projectId}`;
    const method = mode === 'create' ? 'POST' : 'PATCH';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();

    if (data.ok) {
      if (data.warning) alert(data.warning);
      window.location.href = '/admin';
    } else {
      errorEl.textContent = data.error || 'Error al guardar el proyecto';
      errorEl.classList.remove('hidden');
    }
  });
</script>
