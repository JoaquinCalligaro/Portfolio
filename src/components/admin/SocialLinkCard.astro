---
import type { SocialLinkRow } from '../../db/schema';
import AdminCard from './AdminCard.astro';
import IconField from './IconField.astro';
import { inputCls, labelCls } from './ui';

interface Props {
  item?: SocialLinkRow;
}
const { item } = Astro.props as Props;
---

<AdminCard id={item?.id} hidden={item?.hidden}>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div>
      <label class={labelCls}>Nombre de la red</label>
      <input
        data-field="label"
        data-autofocus
        value={item?.label ?? ''}
        placeholder="GitHub, LinkedIn, Instagram..."
        class={inputCls}
      />
    </div>
    <div>
      <label class={labelCls}>Link</label>
      <input
        data-field="url"
        value={item?.url ?? ''}
        placeholder="https://..."
        inputmode="url"
        autocapitalize="none"
        class={inputCls}
      />
    </div>
  </div>
  <IconField iconSlug={item?.iconSlug} iconUrl={item?.iconUrl} />
</AdminCard>
