---
// Campo de ícono: nombre en Simple Icons (con vista previa en vivo) o imagen
// subida. Si hay imagen subida, gana la imagen.
import { inputCls, labelCls, smallBtnCls } from './ui';

interface Props {
  iconSlug?: string;
  iconUrl?: string;
}
const { iconSlug = '', iconUrl = '' } = Astro.props as Props;
const previewSrc =
  iconUrl ||
  (iconSlug
    ? `https://cdn.simpleicons.org/${encodeURIComponent(iconSlug)}`
    : '');
---

<div data-icon-block class="space-y-2">
  <span class={labelCls}>Ícono</span>
  <div class="flex items-center gap-3">
    <div
      class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-gray-800 p-2"
    >
      <img
        data-icon-preview
        src={previewSrc || undefined}
        alt="Vista previa del ícono"
        class:list={['h-full w-full object-contain', !previewSrc && 'hidden']}
      />
      <span
        data-icon-hint
        class:list={[
          'text-center text-[10px] text-gray-500',
          previewSrc && 'hidden',
        ]}
      >
        Sin ícono
      </span>
    </div>
    <div class="min-w-0 flex-1">
      <input
        data-field="iconSlug"
        value={iconSlug}
        placeholder="Nombre del ícono (ej. docker, github)"
        autocapitalize="none"
        autocomplete="off"
        class={inputCls + ' mt-0'}
      />
    </div>
  </div>
  <input type="hidden" data-field="iconUrl" value={iconUrl} />
  <div class="flex flex-wrap items-center gap-2">
    <label class={smallBtnCls + ' cursor-pointer'}>
      o subí una imagen
      <input type="file" accept="image/*" data-icon-file class="sr-only" />
    </label>
    <button
      type="button"
      data-action="clear-icon"
      class:list={[smallBtnCls, !iconUrl && 'hidden']}
    >
      Quitar imagen
    </button>
  </div>
</div>
