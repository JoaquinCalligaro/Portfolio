---
import type { TechRow } from '../../db/schema';
import AdminCard from './AdminCard.astro';
import IconField from './IconField.astro';
import { inputCls, labelCls } from './ui';

interface Props {
  item?: TechRow;
}
const { item } = Astro.props as Props;
---

<AdminCard id={item?.id} hidden={item?.hidden} compact>
  <div class="grid grid-cols-[1fr_auto] items-end gap-3">
    <div>
      <label class={labelCls}>Tecnología</label>
      <input
        data-field="name"
        data-autofocus
        value={item?.name ?? ''}
        placeholder="Docker, React, Figma..."
        class={inputCls}
      />
    </div>
    <div>
      <label class={labelCls}>Color</label>
      <input
        type="color"
        data-field="color"
        data-auto={item ? 'false' : 'true'}
        value={item?.color ?? '#06b6d4'}
        class="mt-1 block h-11 w-14 cursor-pointer rounded-md border border-gray-700 bg-gray-800 p-1"
      />
    </div>
  </div>
  <IconField iconSlug={item?.iconSlug} iconUrl={item?.iconUrl} />
</AdminCard>
