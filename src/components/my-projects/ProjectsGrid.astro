---
import ProjectCard from './ProjectCard.astro';
import { projectsData } from './projectsData.ts';
import ShowMoreBtn from './ShowMoreBtn.astro';
import { listProjects } from '../../db/queries';
import { isDbConfigured } from '../../db/client';
import RealtimeProjectsSync from '../realtime/RealtimeProjectsSync.astro';

// Proyectos fijos en el código (siempre se muestran)
const staticProjects = projectsData.map((project) => ({
  id: project.id,
  titleKey: project.titleKey,
  descriptionKey: project.descriptionKey,
  title: undefined,
  description: undefined,
  repo: project.repo,
  live: project.live,
  technologies: project.technologies,
  images: project.images,
  featured: false,
  // En el respaldo estático se conserva el aspecto original: los que antes
  // estaban "ocultos" quedan en la sección "Ver todos".
  hidden: false,
}));

// Proyectos agregados desde el panel de admin (si la base de datos está conectada)
const dbRows = isDbConfigured ? await listProjects() : [];
const dbProjects = dbRows.map((row) => ({
  id: row.id,
  titleKey: undefined,
  descriptionKey: undefined,
  title: { es: row.titleEs, en: row.titleEn },
  description: { es: row.descriptionEs, en: row.descriptionEn },
  repo: row.repo,
  live: row.live,
  technologies: row.technologies,
  images: row.images,
  featured: row.featured,
  hidden: row.hidden,
}));

// Una vez que los proyectos fijos se migran a la base de datos, se usa solo
// la base de datos para no mostrarlos duplicados. Si todavía no hay nada en
// la base de datos, se usan los proyectos fijos del código como respaldo.
const combinedProjects = dbProjects.length > 0 ? dbProjects : staticProjects;

// Los destacados van primero
const allProjects = combinedProjects.sort(
  (a, b) => Number(b.featured) - Number(a.featured)
);

// Los proyectos ocultos no se muestran en la web. Los primeros 4 van en la
// grilla principal y el resto queda detrás del botón "Ver todos".
const visibleProjects = allProjects.filter((project) => !project.hidden);
const mainProjects = visibleProjects.slice(0, 4);
const extraProjects = visibleProjects.slice(4);
const hasMoreProjects = extraProjects.length > 0;
---

<div class="mt-12" data-realtime-sync="projects">
  <!-- Grid principal con los primeros 4 proyectos visibles -->
  <div class="grid grid-cols-1 gap-15 sm:grid-cols-2 md:grid-cols-2">
    {
      mainProjects.map((project) => (
          <ProjectCard
            id={project.id}
            titleKey={project.titleKey}
            descriptionKey={project.descriptionKey}
            title={project.title}
            description={project.description}
            repo={project.repo}
            live={project.live}
            technologies={project.technologies}
            images={project.images}
          />
        ))
    }
  </div>

  <!-- Contenedor oculto con TODOS los proyectos adicionales (resto de visibles + ocultos) -->
  {
    hasMoreProjects && (
      <>
        <div id="extra-projects" class="mt-8 hidden">
          <div class="grid grid-cols-1 gap-15 sm:grid-cols-2 md:grid-cols-2">
            {extraProjects.map((project) => (
              <div class="hidden">
                <ProjectCard
                  id={project.id}
                  titleKey={project.titleKey}
                  descriptionKey={project.descriptionKey}
                  title={project.title}
                  description={project.description}
                  repo={project.repo}
                  live={project.live}
                  technologies={project.technologies}
                  images={project.images}
                />
              </div>
            ))}
          </div>
        </div>

        <div class="flex justify-center">
          <ShowMoreBtn
            id="show-more-projects"
            text={`Ver todos (${extraProjects.length})`}
          />
        </div>
      </>
    )
  }
</div>

<RealtimeProjectsSync />
