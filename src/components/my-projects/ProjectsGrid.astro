---
import ProjectCard from './ProjectCard.astro';
import ShowMoreBtn from './ShowMoreBtn.astro';
import RealtimeSiteSync from '../realtime/RealtimeSiteSync.astro';
import { translations } from '../../data/translations';
import type { ProjectRow } from '../../db/schema';

interface Props {
  projects: ProjectRow[];
  preview?: boolean;
}

const { projects, preview = false } = Astro.props as Props;

// Los destacados van primero (el orden dentro de cada grupo es el del panel).
const allProjects = [...projects].sort(
  (a, b) => Number(b.featured) - Number(a.featured)
);

// Los proyectos ocultos no se muestran en la web. Los primeros 4 van en la
// grilla principal y el resto queda detrás del botón "Ver todos".
const visibleProjects = allProjects.filter((project) => !project.hidden);
const mainProjects = visibleProjects.slice(0, 4);
const extraProjects = visibleProjects.slice(4);
const hasMoreProjects = extraProjects.length > 0;

const showAllText = translations.ES.showMore.showAll.replace(
  '${total}',
  String(extraProjects.length)
);

const toCard = (project: ProjectRow) => ({
  id: project.id,
  title: { es: project.titleEs, en: project.titleEn || project.titleEs },
  description: {
    es: project.descriptionEs,
    en: project.descriptionEn || project.descriptionEs,
  },
  repo: project.repo,
  live: project.live,
  technologies: project.technologies,
  images: project.images,
});
---

<div class="mt-12" data-realtime-sync="projects">
  <!-- Grid principal con los primeros 4 proyectos visibles -->
  <div class="grid grid-cols-1 gap-15 sm:grid-cols-2 md:grid-cols-2">
    {mainProjects.map((project) => <ProjectCard {...toCard(project)} />)}
  </div>

  <!-- Contenedor oculto con TODOS los proyectos adicionales (resto de visibles) -->
  {
    hasMoreProjects && (
      <>
        <div id="extra-projects" class="mt-8 hidden">
          <div class="grid grid-cols-1 gap-15 sm:grid-cols-2 md:grid-cols-2">
            {extraProjects.map((project) => (
              <div class="hidden">
                <ProjectCard {...toCard(project)} />
              </div>
            ))}
          </div>
        </div>

        <div class="flex justify-center">
          <ShowMoreBtn id="show-more-projects" text={showAllText} />
        </div>
      </>
    )
  }
</div>

{!preview && <RealtimeSiteSync />}
