---
import SocialIcon from './ui/SocialIcon.astro';
import type { ProfileRow, SocialLinkRow } from '../db/schema';

interface Props {
  profile?: ProfileRow | null;
  socialLinks?: SocialLinkRow[];
}

const { profile = null, socialLinks = [] } = Astro.props as Props;
const name = profile?.name?.trim() ?? '';
---

<footer
  class="relative z-10 rounded-md bg-transparent"
  data-realtime-sync="footer"
>
  <div
    class="mx-auto max-w-screen-lg p-4 sm:flex sm:items-center sm:justify-between sm:p-6"
  >
    <p
      class="mb-4 text-center text-sm text-gray-500 sm:mb-0 dark:text-gray-400"
    >
      Built with <span role="img" aria-label="amor">❤️</span> and Astro <span
        role="img"
        aria-label="cohete">🚀</span
      >
      {
        name && (
          <>
            by <span class="text-gray-950 dark:text-white">{name}</span>
          </>
        )
      }
    </p>
    <div class="flex flex-wrap items-center justify-center space-x-1">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex cursor-pointer justify-center rounded-md p-2 text-gray-500 hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
          >
            <SocialIcon
              label={link.label}
              iconSlug={link.iconSlug}
              iconUrl={link.iconUrl}
              class="size-6"
            />
            <span class="sr-only">{link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</footer>
