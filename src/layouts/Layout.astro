---
// Layout principal del sitio - estructura base de todas las páginas
import Footer from '../components/Footer.astro';
import type { ProfileRow, SocialLinkRow } from '../db/schema';
import GoToTopBtn from '../components/ui/GoToTopBtn.astro';
import Navbar from '../components/navbar/Navbar.astro';
import PreviewBanner from '../components/preview/PreviewBanner';
import SmoothBackgroundSwitcher from '../components/ui/background/SmoothBackgroundSwitcher';

import '../styles/base/global.css';

interface Props {
  profile?: ProfileRow | null;
  socialLinks?: SocialLinkRow[];
  // Vista previa del admin: borrador sin publicar
  preview?: boolean;
}

const { profile = null, socialLinks = [], preview = false } = Astro.props as Props;
if (preview) Astro.response.headers.set('Cache-Control', 'no-store');
const siteName = profile?.name?.trim() ?? '';
const pageTitle = siteName ? `Portfolio | ${siteName}` : 'Portfolio';
const description =
  profile?.headlineEs?.trim() ||
  'A small minimalist web developer portfolio built with Astro and TailwindCSS';
---

<!doctype html>
<html lang="ES">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- Metas -->
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <!-- Script de inicialización del tema para evitar parpadeo -->
    <script>
      (function () {
        try {
          let stored = null;
          try {
            stored = localStorage.getItem('color-theme');
          } catch (err) {
            console.debug('Unable to read theme from localStorage', err);
            stored = null;
          }
          const prefersDark =
            typeof window !== 'undefined' &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');

          if (theme === 'dark') {
            try {
              document.documentElement.classList.add('dark');
            } catch (err) {
              console.debug('Failed to add dark class', err);
            }
            // temporary background avoided: rely on CSS fallback in global.css
          }
        } catch (err) {
          console.debug('Theme initializer error', err);
        }
      })();
    </script>
    <!-- Turnstile script is injected only on pages that need it (Contact.astro) -->
  </head>
  <body class:list={['page-root min-h-screen', { 'is-preview': preview }]}>
    {preview && <PreviewBanner client:load />}
    <!-- Background dinámico dark/light con transición suave -->
    <SmoothBackgroundSwitcher
      client:only="react"
      transitionDurationMs={1200}
      fadeStartOpacity={0}
    />

    <Navbar />
    <main
      class="relative z-10 mx-auto flex min-h-screen max-w-screen-lg flex-col gap-12 p-6"
    >
      <slot />
    </main>
    <GoToTopBtn />
    <Footer profile={profile} socialLinks={socialLinks} />

    <!-- Aplica el idioma actual a todos los textos que vienen de la base (ES/EN) -->
    <script is:inline>
      (function () {
        const apply = (lang) => {
          const en = String(lang).toUpperCase() === 'EN';
          document
            .querySelectorAll('[data-i18n-es][data-i18n-en]')
            .forEach((node) => {
              const value = en ? node.dataset.i18nEn : node.dataset.i18nEs;
              if (typeof value === 'string') node.textContent = value;
            });
        };
        window.addEventListener('langChange', (e) =>
          apply((e && e.detail) || document.documentElement.lang || 'ES')
        );
        apply(document.documentElement.lang || 'ES');
      })();
    </script>
  </body>
  <style is:global>
    /* Deja lugar a la barra de vista previa (2.75rem) sin tapar el nav */
    body.is-preview {
      padding-top: 2.75rem;
    }
    body.is-preview #navbar-header {
      top: 2.75rem;
    }
    * {
      scroll-behavior: smooth;
    }
  </style>
</html>
