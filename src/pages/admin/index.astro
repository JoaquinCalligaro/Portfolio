---
// Tablero principal del panel: acceso a cada sección del portfolio
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  getProfile,
  listEducation,
  listProjects,
  listSocialLinks,
  listTechCategoriesWithTechs,
} from '../../db/queries';
import { isDbConfigured } from '../../db/client';

export const prerender = false;

const [profile, projects, categories, education, socials] = await Promise.all([
  getProfile(),
  listProjects(),
  listTechCategoriesWithTechs(),
  listEducation(),
  listSocialLinks(),
]);
const techCount = categories.reduce((sum, c) => sum + c.techs.length, 0);

const sections = [
  {
    href: '/admin/profile',
    title: 'Perfil',
    text: 'Nombre, foto, presentación, CV, biografía y redes sociales.',
    meta: `${profile?.name ? profile.name : 'Sin completar'}, ${socials.length} redes`,
  },
  {
    href: '/admin/tech-stack',
    title: 'Tech Stack',
    text: 'Categorías y tecnologías con su ícono.',
    meta: `${categories.length} categorías, ${techCount} tecnologías`,
  },
  {
    href: '/admin/education',
    title: 'Educación',
    text: 'Línea de tiempo de estudios, trabajos y certificados.',
    meta: `${education.length} entradas`,
  },
  {
    href: '/admin/projects',
    title: 'Proyectos',
    text: 'Tus proyectos, su orden y cuáles se destacan.',
    meta: `${projects.length} proyectos`,
  },
  {
    href: '/admin/contact',
    title: 'Contacto',
    text: 'A qué mail te llegan los mensajes del formulario.',
    meta: profile?.contactToEmail || 'Sin configurar',
  },
];
---

<AdminLayout title="Inicio">
  <h1 class="mb-2 text-xl font-semibold text-white">Panel del portfolio</h1>
  <p class="mb-6 text-sm text-gray-400">
    Todo lo que se ve en tu portfolio se edita desde acá. Escribí solo en
    español: el inglés se traduce solo al guardar.
  </p>

  {
    !isDbConfigured && (
      <div class="mb-6 rounded-md border border-amber-500/40 bg-amber-950/40 p-4 text-sm text-amber-200">
        Todavía no conectaste la base de datos (Neon). Configurá la variable{' '}
        <code>DATABASE_URL</code> para poder editar el contenido. Mientras
        tanto, el sitio público se muestra vacío.
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="flex flex-col gap-2 rounded-xl border border-white/10 bg-gray-900/40 p-5 backdrop-blur-md transition-colors hover:border-cyan-400/50"
        >
          <h2 class="text-lg font-medium text-white">{section.title}</h2>
          <p class="text-sm text-gray-400">{section.text}</p>
          <p class="mt-auto pt-2 text-xs text-cyan-300">{section.meta}</p>
        </a>
      ))
    }
  </div>
</AdminLayout>
