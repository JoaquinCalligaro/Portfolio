---
// Página principal del portfolio
import Layout from '../layouts/Layout.astro';
import SiteContent from '../components/site/SiteContent.astro';
import '../styles/base/global.css';
import { loadSiteData } from '../lib/site-data';

// Todo el contenido viene de la base de datos (vacío si no está configurada)
const data = await loadSiteData();
---

<Layout profile={data.profile} socialLinks={data.socialLinks}>
  <SiteContent data={data} />
</Layout>
