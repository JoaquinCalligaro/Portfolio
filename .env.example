# Base de datos (Neon - Postgres). Se consigue gratis en https://neon.tech
DATABASE_URL=

# Login del panel de admin (/admin)
ADMIN_USERNAME=
# Generar con: pnpm hash-password "tu-contraseña"
ADMIN_PASSWORD_HASH=
# Clave random (mín. 16 caracteres) para cifrar el secreto del 2FA. Obligatoria para activar el 2FA.
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Imágenes, íconos y CV (Cloudinary - gratis en https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Actualización en vivo del panel y la web (Pusher - gratis en https://pusher.com)
# PUSHER_KEY y PUSHER_CLUSTER deben repetirse en las variables PUBLIC_ (mismo valor)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
PUBLIC_PUSHER_KEY=
PUBLIC_PUSHER_CLUSTER=

# Ya existentes (formulario de contacto)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional: remitente con dominio verificado en Resend (si no, usa onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Captcha del formulario (Cloudflare Turnstile - gratis en https://dash.cloudflare.com)
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
